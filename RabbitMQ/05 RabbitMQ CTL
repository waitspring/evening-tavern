━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
rabbitmqctl list_permissions -p VHOST
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
rabbitmqctl 命令回显虚拟机 VHOST 的操作权限列表

rabbitmqctl list_user_permissions U
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
rabbitmqctl 命令回显用户 U 的操作权限列表

rabbitmqctl set_permissions -p VHOST U C W R
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
rabbitmqctl set_permissions 命令基于虚拟机 VHOST 赋予用户 U 配置 (C), 写入 (W), 读取 (R) 交换器与队列对象的权限 (覆盖更新)
rabbitmqctl set_permissions 命令使用正则语法描述配置 (C), 写入 (W), 读取 (R), 正则语法命中的交换器与队列即为用户有权限管理的对象

    ┌────────────────────────────┬──────────────────────────┬──────────────────────────┬──────────────────────────┐
    │ AMQP Command               │ (C)onfigure              │ (W)rite                  │ (R)ead                   │
    ├────────────────────────────┼──────────────────────────┼──────────────────────────┼──────────────────────────┤
    │ Exchange.Declare           │ exchange                 │                          │                          │
    │ Exchange.Declare (with AE) │ exchange                 │ exchange (AE)            │ exchange                 │
    │ Exchange.Delete            │ exchange                 │                          │                          │
    │ Exchange.Bind              │                          │ exchange (destination)   │ exchange (source)        │
    │ Exchange.Unbind            │                          │ exchange (destination)   │ exchange (source)        │
    │ Queue.Declare              │ queue                    │                          │                          │
    │ Queue.Declare (with DLX)   │ queue                    │ exchange (DLX)           │ queue                    │
    │ Queue.Delete               │ queue                    │                          │                          │
    │ Queue.Bind                 │                          │ queue                    │ exchange                 │
    │ Queue.Unbind               │                          │ queue                    │ exchange                 │
    │ Queue.Purge                │                          │                          │ queue                    │
    │ Basic.Publish              │                          │ exchange                 │                          │
    │ Basic.Get                  │                          │                          │ queue                    │
    │ Basic.Consume              │                          │                          │ queue                    │
    └────────────────────────────┴──────────────────────────┴──────────────────────────┴──────────────────────────┘

rabbitmqctl clear_permissions -p VHOST U
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
rabbitmqctl clear_permissions 命令基于虚拟机 VHOST 清除用户 U 配置 (C), 写入 (W), 读取 (R) 交换器与队列对象的权限

""""""""" 演示权限管理命令
[root ~]# rabbitmqctl set_permissions -p season foo '.+' '.+' '.+'
[root ~]# rabbitmqctl list_permissions -p season
[root ~]# rabbitmqctl list_user_permissions foo
[root ~]# rabbitmqctl clear_permissions -p season foo
