━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
广播 (Fanout)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
for binding in exchange.bindings:
    exchange.route(message, binding.queue)

精确匹配 (Direct)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
message.label.routing_key = ^[0-9a-zA-Z\-_.]+$
binding.binding_key = ^[0-9a-zA-Z\-_.*#]+$
for binding in exchange.bindings:
    if message.label.routing_key == binding.binding_key:
        exchange.route(message, binding.queue)

